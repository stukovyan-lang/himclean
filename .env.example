# REQUIRED in production: the site's own domain, no trailing slash.
# Canonical links, sitemap.xml and robots.txt are built from it.
NEXT_PUBLIC_SITE_URL=https://example.com

# Yandex Metrika counter id. Empty value disables the counter.
YANDEX_METRIKA_ID=

# Search console verification tokens.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# Set to 1 on Vercel PREVIEW environments only, never on production.
# Lifts the draft rewrite so unfinished pages can be shown to the client.
# Pages stay noindex and the sitemap stays empty regardless of this value.
PREVIEW_UNLOCK=

# Not needed: the approved design is on by default. Set to 0 only to see the
# original pre-redesign pages.
DEMO_MODE=

# Set to 1 when building on a server without Chrome (a plain VPS): skips the
# post-build contrast check, which needs Chrome. Vercel skips it on its own.
SKIP_CONTRAST_CHECK=
